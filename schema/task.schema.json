{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ThatGuySteve/Intentacle/schema/task/0.1.0-draft",
  "title": "Intentacle experimental task record",
  "description": "Structure only. Use the semantic validator for provenance, references, review scope, and next-step readiness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "revision",
    "next_step",
    "references",
    "items",
    "unknowns",
    "conflicts"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0-draft" },
    "task_id": { "$ref": "#/$defs/id" },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "next_step": { "$ref": "#/$defs/step" },
    "references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/reference" }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": { "$ref": "#/$defs/item" }
    },
    "unknowns": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/unknown" }
    },
    "conflicts": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/conflict" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,79}$" },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000,
      "pattern": "\\S"
    },
    "step": { "enum": ["clarify", "inspect", "plan", "execute"] },
    "ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "steps": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/step" }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "availability"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["user_request", "user_answer", "document"] },
        "availability": { "enum": ["supplied", "unavailable"] },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200000,
          "pattern": "\\S"
        },
        "locator": { "$ref": "#/$defs/text" },
        "applies_to": { "$ref": "#/$defs/ids" }
      },
      "allOf": [
        {
          "if": { "properties": { "availability": { "const": "supplied" } } },
          "then": { "required": ["content"] },
          "else": {
            "required": ["locator"],
            "not": { "required": ["content"] },
            "properties": { "kind": { "const": "document" } }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "user_answer" } } },
          "then": { "required": ["applies_to"] },
          "else": { "not": { "required": ["applies_to"] } }
        }
      ]
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "text", "origin", "source_ids", "review"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": {
          "enum": [
            "objective",
            "context",
            "constraint",
            "success_criterion",
            "output"
          ]
        },
        "text": { "$ref": "#/$defs/text" },
        "origin": {
          "enum": ["user_stated", "source_reported", "inferred", "default"]
        },
        "source_ids": { "$ref": "#/$defs/ids" },
        "rationale": { "$ref": "#/$defs/text" },
        "strength": { "enum": ["hard", "preference"] },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": {
            "state": {
              "enum": ["unreviewed", "confirmed", "delegated", "rejected"]
            },
            "source_id": { "$ref": "#/$defs/id" }
          },
          "allOf": [
            {
              "if": { "properties": { "state": { "const": "unreviewed" } } },
              "then": { "not": { "required": ["source_id"] } },
              "else": { "required": ["source_id"] }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "constraint" } } },
          "then": { "required": ["strength"] },
          "else": { "not": { "required": ["strength"] } }
        },
        {
          "if": {
            "properties": { "origin": { "enum": ["inferred", "default"] } }
          },
          "then": { "required": ["rationale"] }
        }
      ]
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "necessity",
        "blocks",
        "next_action",
        "status"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "question": { "$ref": "#/$defs/text" },
        "necessity": { "enum": ["required", "important", "optional"] },
        "blocks": { "$ref": "#/$defs/steps" },
        "next_action": {
          "enum": ["ask_user", "inspect_source", "offer_choices"]
        },
        "status": { "enum": ["open", "resolved"] },
        "resolution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "source_ids"],
          "properties": {
            "text": { "$ref": "#/$defs/text" },
            "source_ids": { "$ref": "#/$defs/ids" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "necessity": { "const": "required" } } },
          "then": {
            "properties": { "blocks": { "type": "array", "minItems": 1 } }
          },
          "else": {
            "properties": { "blocks": { "type": "array", "maxItems": 0 } }
          }
        },
        {
          "if": { "properties": { "status": { "const": "resolved" } } },
          "then": { "required": ["resolution"] },
          "else": { "not": { "required": ["resolution"] } }
        }
      ]
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "item_ids", "description", "blocks", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "item_ids": { "$ref": "#/$defs/ids", "type": "array", "minItems": 2 },
        "description": { "$ref": "#/$defs/text" },
        "blocks": { "$ref": "#/$defs/steps", "type": "array", "minItems": 1 },
        "status": { "enum": ["open", "resolved"] },
        "resolution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["note", "source_id"],
          "properties": {
            "note": { "$ref": "#/$defs/text" },
            "source_id": { "$ref": "#/$defs/id" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "resolved" } } },
          "then": { "required": ["resolution"] },
          "else": { "not": { "required": ["resolution"] } }
        }
      ]
    }
  }
}
